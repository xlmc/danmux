{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danmux.dev/schema/compatibility-wire-v1.schema.json",
  "title": "DanDanPlay Base + DanmuX Enhanced Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["p", "m"],
  "properties": {
    "p": { "type": "string", "description": "time,mode,fontSize,color; field order and units are stable" },
    "m": { "type": "string" },
    "danmux": {
      "type": "object", "additionalProperties": false, "required": ["extensionVersion"],
      "properties": {
        "extensionVersion": { "const": 1 },
        "effects": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "lossReport": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
